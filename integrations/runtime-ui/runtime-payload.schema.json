{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bynanci/website-design-skill/blob/main/integrations/runtime-ui/runtime-payload.schema.json",
  "title": "Bounded media recovery UI payload",
  "description": "Versioned data only. The host also enforces UTF-8 payload/text budgets, total node count, exact request/state binding and current action authorization.",
  "$comment": "Additional runtime limits: UTF-8 payload <=8192 bytes, combined displayed text <=4096 bytes, <=32 total nodes, <=4 node levels. Host injects capability tokens only after validation; producer payloads must not contain tokens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryVersion",
    "requestId",
    "stateVersion",
    "expiresAfterMs",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ui-panel/0.1"
    },
    "registryVersion": {
      "const": "media-recovery/0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "stateVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^media-state-[0-9]+$"
    },
    "expiresAfterMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/Node1"
      }
    }
  },
  "$defs": {
    "Notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "props"
      ],
      "properties": {
        "type": {
          "const": "Notice"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tone",
            "title",
            "text"
          ],
          "properties": {
            "tone": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "ActionButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "props",
        "action"
      ],
      "properties": {
        "type": {
          "const": "ActionButton"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "params"
          ],
          "properties": {
            "id": {
              "const": "retryMediaRead"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        }
      }
    },
    "Node4": {
      "oneOf": [
        {
          "$ref": "#/$defs/Notice"
        },
        {
          "$ref": "#/$defs/ActionButton"
        }
      ]
    },
    "Node3": {
      "oneOf": [
        {
          "$ref": "#/$defs/Notice"
        },
        {
          "$ref": "#/$defs/ActionButton"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "props",
            "children"
          ],
          "properties": {
            "type": {
              "const": "Group"
            },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/Node4"
              }
            }
          }
        }
      ]
    },
    "Node2": {
      "oneOf": [
        {
          "$ref": "#/$defs/Notice"
        },
        {
          "$ref": "#/$defs/ActionButton"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "props",
            "children"
          ],
          "properties": {
            "type": {
              "const": "Group"
            },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/Node3"
              }
            }
          }
        }
      ]
    },
    "Node1": {
      "oneOf": [
        {
          "$ref": "#/$defs/Notice"
        },
        {
          "$ref": "#/$defs/ActionButton"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "props",
            "children"
          ],
          "properties": {
            "type": {
              "const": "Group"
            },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/Node2"
              }
            }
          }
        }
      ]
    }
  }
}
